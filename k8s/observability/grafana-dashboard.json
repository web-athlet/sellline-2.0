{
  "__comment": "Import into Grafana (Dashboards → Import). Datasource var ${DS_PROM} = your Prometheus. Panels use ingress-nginx + kube-state metrics that exist today; add API histograms once /api/metrics (TD-S16b-02) ships.",
  "title": "NextGen CRM — Production",
  "uid": "nextgen-prod",
  "tags": ["nextgen", "production"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (rps)",
      "type": "timeseries",
      "datasource": "${DS_PROM}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(nginx_ingress_controller_requests{exported_namespace=\"nextgen-prod\"}[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx error ratio",
      "type": "stat",
      "datasource": "${DS_PROM}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_ingress_controller_requests{exported_namespace=\"nextgen-prod\",status=~\"5..\"}[5m])) / sum(rate(nginx_ingress_controller_requests{exported_namespace=\"nextgen-prod\"}[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 latency (s)",
      "type": "timeseries",
      "datasource": "${DS_PROM}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nginx_ingress_controller_request_duration_seconds_bucket{exported_namespace=\"nextgen-prod\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "Pod restarts (15m)",
      "type": "timeseries",
      "datasource": "${DS_PROM}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(kube_pod_container_status_restarts_total{namespace=\"nextgen-prod\"}[15m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}
