# Database (Postgres 15 + pgvector)
DATABASE_URL=postgresql://nextgen:nextgen@localhost:5432/nextgen?schema=public

# Cache / Queue
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO, S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=nextgen
MINIO_SECRET_KEY=nextgen-dev-only
MINIO_BUCKET=nextgen-crm

# Frontend → API
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# API → Frontend (CORS-Origin für HTTP + WebSocket-Gateway)
NEXT_PUBLIC_WEB_URL=http://localhost:3000
