# Database (Postgres 15 + pgvector)
DATABASE_URL=postgresql://nextgen:nextgen@localhost:5432/nextgen?schema=public

# Cache / Queue
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO, S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=nextgen
MINIO_SECRET_KEY=nextgen-dev-only
MINIO_BUCKET=nextgen-crm

# Frontend → API
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# API → Frontend (CORS-Origin für HTTP + WebSocket-Gateway)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Authentication (Session 2)
# ─────────────────────────────────────────────────────────────────────────────

# JWT signing secret — used for access tokens, pre-2fa tokens, setup-2fa tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Token TTLs (vercel/ms format)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# AES-256-GCM encryption key for OAuth tokens (Gmail/Outlook) and 2FA secrets.
# MUST be exactly 64 hex chars (= 32 bytes). Losing this bricks all 2FA + OAuth tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=00000000000000000000000000000000000000000000000000000000deadbeef

# NextAuth (frontend session signing)
NEXTAUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# Optional cookie-domain override (leave blank for default = host)
COOKIE_DOMAIN=

# OAuth2 — Google (optional). Without these the /auth/google routes return 503.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# OAuth2 — Microsoft (optional). Without these the /auth/microsoft routes return 503.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/microsoft/callback

# Prod-Seed-Guard override (Session 1 fix). Set to 1 to allow `prisma db seed` in production.
SEED_ALLOW_PROD=

# ─────────────────────────────────────────────────────────────────────────────
# E-Mail-Sync (Session 11)
# ─────────────────────────────────────────────────────────────────────────────

# Gmail email-sync scopes. Reuses GOOGLE_OAUTH_CLIENT_ID/SECRET from auth.
# Callback URL for the email-specific OAuth flow (different from auth callback).
GMAIL_SYNC_CALLBACK_URL=http://localhost:3001/api/v1/email/gmail/callback

# HMAC secret for signing OAuth state params (prevents CSRF on OAuth callbacks).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_OAUTH_STATE_SECRET=change-me-to-a-random-32-byte-hex-string

# Google Cloud PubSub for Gmail push notifications (optional in dev — poll fallback used if absent).
GCP_PUBSUB_PROJECT=
GCP_PUBSUB_TOPIC=nextgen-gmail-push
# Google service-account email for PubSub JWT verification.
GCP_PUBSUB_SA_EMAIL=

# Outlook email-sync. Reuses MICROSOFT_OAUTH_CLIENT_ID/SECRET from auth.
OUTLOOK_SYNC_CALLBACK_URL=http://localhost:3001/api/v1/email/outlook/callback

# OpenAI for GPT-4o thread summaries + campaign subject suggestions (optional — 503 if absent).
OPENAI_API_KEY=

# Campaigns (Session 12)
# HMAC secret for tracking tokens (open/click/unsub). Falls back to JWT_SECRET if absent.
# Recommended: a separate 32-byte hex secret for isolation.
CAMPAIGN_TRACKING_SECRET=change-me-to-a-random-32-byte-hex-string
